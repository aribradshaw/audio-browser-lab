{
  "name": "@audio-browser-lab/cli",
  "version": "0.1.0",
  "description": "Command-line audio structure inspection and browser report diagnostics.",
  "type": "module",
  "bin": { "abl": "./dist/index.js" },
  "main": "./dist/library.js",
  "types": "./dist/library.d.ts",
  "exports": {
    ".": { "types": "./dist/library.d.ts", "import": "./dist/library.js" },
    "./library": { "types": "./dist/library.d.ts", "import": "./dist/library.js" }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": { "@audio-browser-lab/core": "*" },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/aribradshaw/audio-browser-lab.git", "directory": "packages/cli" },
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=20" }
}
