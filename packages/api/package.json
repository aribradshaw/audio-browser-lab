{
  "name": "@audio-browser-lab/api",
  "version": "0.1.0",
  "description": "Embeddable local HTTP API for Audio Browser Lab diagnostics.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
