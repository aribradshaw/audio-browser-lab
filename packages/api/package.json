  "dependencies": { "@audio-browser-lab/core": "*" },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/aribradshaw/audio-browser-lab.git", "directory": "packages/api" },
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=20" }
}
